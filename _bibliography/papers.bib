@techreport{skt2026axk2,
  title={A.X K2 Technical Report},
  author={Baek, Cheolseung and Kim, Eunki and Yang, Hyunho and Eun, Hyunjun and Kim, Jin and Park, Junyoung and Wee, Juyun and Kim, Minsang and Kang, Minsoo and Choi, Seongho and Lee, Sangyeol and Jo, Seokhwan and Cho, Seonghye and Ok, Seongmin and Yi, Subin and Cheon, Sung Jun and Kim, Sungwan and Kim, Tae Yoon and Arya, Dhammiko and Song, Gun and Han, Gyoungeun and Hong, Minki and Park, Minkyung and Kim, SaeRom and Kim, Sangjin and Lee, Seojin and Hong, Seokyoung and Sek, Sereimony and Kim, Singon and Park, Sohee and Yoon, Sungbin and Lee, Sungeun and Lee, Sunwoo and Jang, Wonbeom and Ra, Yohan and Han, Yong-jin and Kang, Yujin and Lee, Yujin and Kim, Seungsik and Kim, Youngrang and Cho, Seungmo and Park, Sooyeon and Kim, Youngjin},
  year={2026},
  month={aug},
  institution={SK Telecom},
  pdf={https://github.com/SKT-AI/A.X-K2/blob/main/A_X_K2_Tech_Report.pdf},
  html={https://huggingface.co/skt/A.X-K2},
  code={https://github.com/SKT-AI/A.X-K2},
  abstract={We introduce A.X K2, a 688B-parameter Mixture-of-Experts (MoE) language model trained from scratch as a high-performance foundation for agentic applications. Trained on approximately 8.5T tokens---fewer than its predecessor, A.X K1---on a smaller but higher-quality mixture with substantially expanded agentic and software-engineering data, it nonetheless improves over A.X K1 across the board, by over 30 percentage points on some benchmarks, reflecting large gains in token efficiency. To support long contexts efficiently, we introduce Sparse Gated Attention (SGA), which combines sparse attention with gated attention, and adopt Gated Norm (GN) to stabilize large-scale training. SGA is trained natively at 128K through a sparse indexer warmup that optimizes the indexer against its own sparse top-k selection rather than the dense attention distribution, making adaptation markedly cheaper: each query reads only 2,048 positions, yet long-context quality is unchanged and A.X K2 scores 94.6 on RULER out to 256K. The outlier suppression of GN in turn keeps 4-bit NVFP4 serving within one point of FP8 accuracy. A simple yet effective Think-Fusion recipe further lets users switch between thinking and non-thinking modes within a single unified model.},
  selected={true},
}
@article{cheon2026axk1,
  title={A.X K1 Technical Report},
  author={Cheon, Sung Jun and Cho, Jaekyung and Choi, Seongho and Eun, Hyunjun and Jo, Seokhwan and Jun, Jaehyun and Kang, Minsoo and Kim, Jin and Kim, Jiwon and Kim, Minsang and Kim, Seungsik and Kim, Sungwan and Kim, Tae Yoon and Kim, Youngrang and Lee, Hyeongmun and Lee, Sangyeol and Lee, Sungeun and Lee, Youngsoon and Lee, Yujin and Ok, Seongmin and Park, Chanyong and Park, Hyewoong and Park, Junyoung and Yang, Hyunho and Yi, Subin and Arya, Dhammiko and Bae, Soohyun and Cho, Dongyeon and Cho, Seungmo and Choi, Sangho and Choi, Yongseok and Han, Gyoungeun and Han, Yong-jin and Hong, Seokyoung and Hwang, Hyeon and Jang, Wonbeom and Ju, Minjeong and Jung, Wonjin and Ka, Keummin and Kang, Sungil and Kim, Dongnam and Kim, Jonghwi and Kim, Joonghoon and Kim, SaeRom and Kim, Sangjin and Kim, Seongwon and Kim, Youngjin and Lee, Seojin and Lee, Sunwoo and Lee, Taehoon and Park, Chanwoo and Park, Sohee and Park, Sooyeon and Ra, Yohan and Sek, Sereimony and Seo, Seungyeon and Song, Gun and Woo, Sanghoon and Yoon, Janghan and Yoon, Sungbin},
  year={2026},
  eprint={2601.09200},
  archivePrefix={arXiv},
  primaryClass={cs.CL},
  url={https://arxiv.org/abs/2601.09200},
  doi={10.48550/arXiv.2601.09200},
  arxiv={2601.09200},
  pdf={https://arxiv.org/pdf/2601.09200},
  html={https://huggingface.co/skt/A.X-K1},
  code={https://github.com/SKT-AI/A.X-K1},
  abstract={We introduce A.X K1, a 519B-parameter Mixture-of-Experts (MoE) language model trained from scratch. Our design leverages scaling laws to optimize training configurations and vocabulary size under fixed computational budgets. A.X K1 is pre-trained on a corpus of approximately 10T tokens, curated by a multi-stage data processing pipeline. Designed to bridge the gap between reasoning capability and inference efficiency, A.X K1 supports explicitly controllable reasoning to facilitate scalable deployment across diverse real-world scenarios. We propose a simple yet effective Think-Fusion training recipe, enabling user-controlled switching between thinking and non-thinking modes within a single unified model. Extensive evaluations demonstrate that A.X K1 achieves performance competitive with leading open-source models, while establishing a distinctive advantage in Korean-language benchmarks.},
  preview={axk1.png},
  selected={true},
}
@inproceedings{lee-etal-2025-telagentbench,
  title = "{T}el{A}gent{B}ench: A Multi-faceted Benchmark for Evaluating {LLM}-based Agents in Telecommunications",
  author = "Lee, Sunwoo  and
    Jang, Daseong  and
    Arya, Dhammiko  and
    Han, Gyoung-eun  and
    Song, Injee  and
    Kim, SaeRom  and
    Kim, Sangjin  and
    Lee, Seojin  and
    Hong, Seokyoung  and
    Sek, Sereimony  and
    Cho, Seung-Mo  and
    Park, Sohee  and
    Yoon, Sungbin  and
    Jang, Wonbeom  and
    Davis, Eric",
  booktitle = "Proceedings of the 2025 Conference on Empirical Methods in Natural Language Processing: Industry Track",
  month = nov,
  year = "2025",
  address = "Suzhou, China",
  publisher = "Association for Computational Linguistics",
  url = "https://aclanthology.org/2025.emnlp-industry.83/",
  doi = "10.18653/v1/2025.emnlp-industry.83",
  pages = "1173--1211",
  pdf={https://aclanthology.org/2025.emnlp-industry.83.pdf},
  abstract={As Large Language Models (LLMs) evolve into powerful agentic systems, the telecommunications industry's expansion into AI services necessitates industry-grounded benchmarks to evaluate their underexplored domain-specific capabilities. To address the gap left by generic benchmarks that fail to assess realistic, non-English performance, we present TelAgentBench, a Korean benchmark for the telecommunications domain evaluating five core agentic capabilities: Reasoning, Planning, Action (tool-use), Retrieval-Augmented Generation, and Instruction Following. Evaluations reveal significant performance disparities between models that employ explicit reasoning and those that do not, providing actionable insights for deploying agentic LLMs in real-world telecommunications tasks.},
  preview={telagentbench.png},
  selected={true},
}
@inproceedings{lee-etal-2024-telbench,
  title = "{T}el{B}ench: A Benchmark for Evaluating Telco-Specific Large Language Models",
  author = "Lee, Sunwoo  and
    Arya, Dhammiko  and
    Cho, Seung-Mo  and
    Han, Gyoung-eun  and
    Hong, Seokyoung  and
    Jang, Wonbeom  and
    Lee, Seojin  and
    Park, Sohee  and
    Sek, Sereimony  and
    Song, Injee  and
    Yoon, Sungbin  and
    Davis, Eric",
  editor = "Dernoncourt, Franck  and
    Preo{\c{t}}iuc-Pietro, Daniel  and
    Shimorina, Anastasia",
  booktitle = "Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing: Industry Track",
  month = nov,
  year = "2024",
  address = "Miami, Florida, US",
  publisher = "Association for Computational Linguistics",
  url = "https://aclanthology.org/2024.emnlp-industry.45",
  doi = "10.18653/v1/2024.emnlp-industry.45",
  pdf={https://aclanthology.org/2024.emnlp-industry.45.pdf},
  pages = "609--626",
  preview={telbench.png},
  abstract = "The telecommunications industry, characterized by its vast customer base and complex service offerings, necessitates a high level of domain expertise and proficiency in customer service center operations. Consequently, there is a growing demand for Large Language Models (LLMs) to augment the capabilities of customer service representatives. This paper introduces a methodology for developing a specialized Telecommunications LLM (Telco LLM) designed to enhance the efficiency of customer service agents and promote consistency in service quality across representatives. We present the construction process of TelBench, a novel dataset created for performance evaluation of customer service expertise in the telecommunications domain. We also evaluate various LLMs and demonstrate the ability to benchmark both proprietary and open-source LLMs on predefined telecommunications-related tasks, thereby establishing metrics that define telcommunications performance.",
  selected={true},
}
